# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL base da aplicação (usada pelo Better Auth e na montagem de links públicos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Banco de dados (docker compose up -d postgres)
# Porta 5433 no host para não colidir com um Postgres instalado localmente.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://quizfunnels:quizfunnels@127.0.0.1:5433/quizfunnels

# ─────────────────────────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-este-valor-em-producao-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Storage S3-compatível
# Local  → MinIO (valores abaixo)
# Produção → AWS S3 ou Cloudflare R2: basta trocar endpoint/região/chaves.
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quiz-funnels
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO exige path-style; S3/R2 usam virtual-hosted (deixe false)
S3_FORCE_PATH_STYLE=true
# URL pública dos arquivos (CDN em produção)
S3_PUBLIC_URL=http://localhost:9000/quiz-funnels

# ─────────────────────────────────────────────────────────────
# IA (OpenRouter)
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Modelo padrão do copiloto de funis
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ─────────────────────────────────────────────────────────────
# E-mail
# Local  → Mailpit (SMTP em localhost:1025, web em localhost:8025)
# Produção → Resend
# ─────────────────────────────────────────────────────────────
EMAIL_FROM=nao-responda@localhost
RESEND_API_KEY=
