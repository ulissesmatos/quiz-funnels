# ─────────────────────────────────────────────────────────────
# App
# ─────────────────────────────────────────────────────────────
# URL base da aplicação (usada pelo Better Auth e na montagem de links públicos)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─────────────────────────────────────────────────────────────
# Banco de dados (docker compose up -d postgres)
# Porta 5433 no host para não colidir com um Postgres instalado localmente.
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://quizfunnels:quizfunnels@127.0.0.1:5433/quizfunnels

# ─────────────────────────────────────────────────────────────
# Autenticação
# ─────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-este-valor-em-producao-min-32-chars
BETTER_AUTH_URL=http://localhost:3000

# Cifra o access/refresh token do Mercado Pago de cada organização antes de
# gravar no banco. 32 bytes em base64 — gere com: openssl rand -base64 32
# Trocar esta chave em produção invalida toda conexão Mercado Pago já salva
# (cada organização precisa reconectar pela tela de Configurações).
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────
# Storage S3-compatível
# Local  → MinIO (valores abaixo)
# Produção → AWS S3 ou Cloudflare R2: basta trocar endpoint/região/chaves.
# ─────────────────────────────────────────────────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=quiz-funnels
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# MinIO exige path-style; S3/R2 usam virtual-hosted (deixe false)
S3_FORCE_PATH_STYLE=true
# URL pública dos arquivos (CDN em produção)
S3_PUBLIC_URL=http://localhost:9000/quiz-funnels

# ─────────────────────────────────────────────────────────────
# IA (OpenRouter)
# ─────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=
# Modelo padrão do copiloto de funis
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# ─────────────────────────────────────────────────────────────
# E-mail
# Local  → Mailpit (SMTP em localhost:1025, web em localhost:8025)
# Produção → Resend
# ─────────────────────────────────────────────────────────────
EMAIL_FROM=nao-responda@localhost
RESEND_API_KEY=

# ─────────────────────────────────────────────────────────────
# Pagamento (Mercado Pago)
# Credenciais da SUA Application em https://www.mercadopago.com.br/developers
# — não são chave de nenhum cliente. Cada organização conecta a própria conta
# depois, pela tela de Configurações.
# ─────────────────────────────────────────────────────────────
MERCADOPAGO_APP_ID=
MERCADOPAGO_CLIENT_SECRET=
# Gerado no painel de Webhooks da sua Application, depois de configurar a URL de notificação
MERCADOPAGO_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Faturamento do SaaS (cobrar as organizações que usam a plataforma)
# Access Token da SUA PRÓPRIA conta Mercado Pago — não confundir com as
# credenciais de Application acima, que são só pra OAuth Connect dos clientes.
# ─────────────────────────────────────────────────────────────
MERCADOPAGO_PLATFORM_ACCESS_TOKEN=
# Gerado no painel de Webhooks da SUA conta MP, ao configurar a URL de notificação de /api/webhooks/mercadopago-platform
MERCADOPAGO_PLATFORM_WEBHOOK_SECRET=

# ─────────────────────────────────────────────────────────────
# Faturamento do SaaS via Stripe (alternativa ao Mercado Pago acima)
# Chaves da SUA conta Stripe em https://dashboard.stripe.com/apikeys
# ─────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
# Gerado ao criar o endpoint de webhook em https://dashboard.stripe.com/webhooks, apontando pra /api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=
